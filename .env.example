# =============================================================================
# FreshLoop AI — environment template (copy to .env.local, set in Vercel)
# =============================================================================

# --- PostgreSQL (Supabase) — serverless pool + direct session ----------------
# Runtime (Next.js / Prisma Client): Transaction pooler, port 6543, pgbouncer.
# Example:
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DATABASE_URL=

# Migrations only (prisma migrate deploy): Session mode, port 5432 (direct).
# Example:
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-us-west-2.pooler.supabase.com:5432/postgres"
DIRECT_URL=

# --- Auth.js (sessions) ------------------------------------------------------
# Required in production. Generate: openssl rand -base64 32
AUTH_SECRET=

# Legacy alias (optional if AUTH_SECRET is set)
# NEXTAUTH_SECRET=

# Canonical app URL (Auth.js trustHost + password-reset links)
# Local: http://localhost:3000  |  Prod: https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000

# Public site URL (links, OG, client hints) — set to production URL on Vercel
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Gemini (invoice OCR, voice logger, recipe fusion) ---------------
GEMINI_API_KEY=

# --- Email (optional — password reset via Resend) ---------------------------
# RESEND_API_KEY=
# EMAIL_FROM="FreshLoop <noreply@yourdomain.com>"

# --- Staff signup (optional) --------------------------------------------------
# ALLOW_PUBLIC_SIGNUP=false

# --- POS ingest (required for POST /api/pos/webhook) -------------------------
# Generate: openssl rand -base64 32
# POS_WEBHOOK_SECRET=
