// =============================================================================
// FreshLoop AI — Database Schema
// =============================================================================
// This schema keeps the canonical inventory-ledger model and the legacy bridge
// tables needed by the app's current UI and API routes.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TransactionType {
  Receive
  Sale
  Rescue
  Waste
  POS_Sale
  /// Count correction. Excluded from the waste KPI.
  Adjustment
}

enum InventoryLocation {
  External_Vendor
  Main_Storage
  Retail_Floor
  Kitchen_Prep
  Deli_Grab_N_Go
  Customer_Out
  Waste_Bin
}

enum Department {
  PRODUCE
  DAIRY
  BAKERY
  PANTRY
  DELI_KITCHEN
}

enum UnitType {
  KG
  LBS
  LITER
  ML
  UNIT
  BUNCH
  LOAF
  TUB
  CASE
}

enum InventoryStatus {
  FRESH
  WARNING
  PULL_RESCUE
  MARKDOWN
  DISCARDED
}

enum TargetAction {
  KITCHEN_RESCUE
  MARKDOWN
  DISCARD
}

enum RecipeStatus {
  PROPOSED
  IN_KITCHEN
  COMPLETED
}

enum Role {
  ADMIN
  STORE_MANAGER
  RECEIVING_CLERK
  FLOOR_STAFF
  DELI_CHEF
}

model Product {
  id                 String                 @id @default(uuid())
  barcode            String?                @unique
  name               String
  department         Department
  targetMargin       Float                  @default(0.4)
  unitType           UnitType               @default(UNIT)
  /// Sellable catalog units per case (after split): receivePackSize ÷ splitFactor.
  casePackSize       Float?                 @default(1)
  /// Invoice / receive pack size before split (e.g. lbs or units on the case).
  receivePackSize    Float?
  /// Split factor at receive (e.g. 2 when half the case pack is sellable per unit).
  splitFactor        Float?                 @default(1)
  parCases           Int                    @default(2)
  yieldPct           Float?                 @default(100)
  shelfLifeDays      Int                    @default(7)
  /// Per-SKU pull/rescue window (2–4 days). Null uses store default.
  pullSensitivityDays Int?                  @map("pull_sensitivity_days")
  supplier           String?
  origin             String?
  standardCost       Float?
  /// Invoice or catalog-override cost for one case (source of truth for catalog Case cost column).
  receiveCaseCost    Float?                 @map("receive_case_cost")
  /// Invoice / manual shelf price for the full case (independent of unit retailPrice).
  caseRetailPrice    Float?                 @map("case_retail_price")
  retailPrice        Float?
  regularRetailPrice Float?
  isManufactured    Boolean                @default(false)
  /** When false, hidden from admin/receiving catalog until re-added; ledger history kept. */
  catalogActive      Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  transactions   InventoryTransaction[]
  producedRecipes Recipe[]               @relation("RecipeOutputProduct")
  usedInBOMs     RecipeBOM[]            @relation("BomIngredientProduct")
  bundleItems    BundleItem[]
  posMappings    POSMapping[]
  inventoryItems InventoryItem[]
  inventoryLots  InventoryLot[]
  markdownEvents     MarkdownEvent[]
  floorBundlePromos  FloorBundlePromo[]
  priceVarianceLogs  PriceVarianceLog[]

  @@index([department])
  @@index([name])
  @@index([supplier])
  @@index([catalogActive, isManufactured])
  @@map("products")
}

/// FIFO lot balances per location (receive creates lots; moves/sales consume oldest first).
model InventoryLot {
  id                   String            @id @default(uuid())
  productId            String            @map("product_id")
  product              Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  location             InventoryLocation
  qtyRemaining         Float             @map("qty_remaining")
  unitCostAtTime       Float             @map("unit_cost_at_time")
  receivedAt           DateTime          @default(now()) @map("received_at")
  expirationDate       DateTime?         @map("expiration_date")
  receiveReferenceId   String?           @map("receive_reference_id")
  receiveTransactionId String?           @map("receive_transaction_id")

  @@index([productId, location, expirationDate, receivedAt])
  @@map("inventory_lots")
}

/// Commercial markdown audit (revenue given up at time of discount).
model MarkdownEvent {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  staffId       String   @map("staff_id")
  quantityUnits Float    @map("quantity_units")
  regularPrice  Float    @map("regular_price")
  markdownPrice Float    @map("markdown_price")
  discountPct   Float    @map("discount_pct")
  revenueImpact Float    @map("revenue_impact")
  referenceId   String?  @map("reference_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@map("markdown_events")
}

/// Manager-saved multi-unit promo (signage / planning). Not applied to POS automatically.
model FloorBundlePromo {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  minUnits    Float    @map("min_units")
  bundlePrice Float    @map("bundle_price")
  label       String?
  createdById String   @map("created_by_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([productId, isActive])
  @@index([isActive, updatedAt])
  @@map("floor_bundle_promos")
}

model Store {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  timezone  String   @default("America/Toronto")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings StoreSetting[]

  @@map("stores")
}

model InventoryTransaction {
  id              String            @id @default(uuid())
  timestamp       DateTime          @default(now())
  productId       String            @map("Product_ID")
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  staffId         String            @map("Staff_ID")
  qtyChange       Float             @map("Qty_Change")
  transactionType TransactionType   @map("Transaction_Type")
  fromLocation    InventoryLocation @map("From_Location")
  toLocation      InventoryLocation @map("To_Location")
  unitCostAtTime  Float             @map("Unit_Cost_At_Time")
  /// Unit price charged for this sale line when it was written. Null on legacy rows.
  realizedUnitPrice   Float?        @map("realized_unit_price")
  /// Line revenue in dollars captured at sale time. Null means the original price is unknown.
  realizedLineRevenue Float?        @map("realized_line_revenue")
  referenceId     String?           @map("Reference_ID")
  expirationDate  DateTime?
  notes           String?
  /// Charged bundle revenue on one POS_Sale row. Product sales keep the unit price in Unit_Cost_At_Time.
  extendedRevenue Float?            @map("extended_revenue")
  /// Volumetric scrap bucket count. Qty_Change stays 0 so the anchor SKU on-hand does not move.
  scrapBucketCount Float?           @map("scrap_bucket_count")

  @@index([productId, timestamp])
  @@index([productId, transactionType, timestamp])
  @@index([transactionType, timestamp])
  @@index([transactionType, toLocation, timestamp])
  @@index([fromLocation, toLocation])
  @@index([productId, fromLocation, toLocation])
  @@index([referenceId])
  @@index([expirationDate])
  @@map("Inventory_Transactions")
}

model StoreSetting {
  id                        String   @id @default(uuid())
  storeId                   String?  @map("store_id")
  store                     Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  storeName                 String   @default("FreshLoop Independent Market")
  targetWastePct            Float    @default(2.5) @map("Target_Waste_Pct")
  scrapBucketVolumeL        Float    @default(20.0) @map("Scrap_Bucket_Volume_L")
  estimatedWeightPerLiterKg Float    @default(0.65) @map("Estimated_Weight_Per_Liter_kg")
  defaultScrapCostPerKg     Float    @default(3.5)
  pullSensitivityDays       Int      @default(3)
  costGuardrailVariancePct  Float    @default(20.0)
  /// Brynn's Sheets default (e.g. $17.60/hr) when Recipe.laborRate is null.
  defaultLaborRatePerHour   Float    @default(17.6) @map("Default_Labor_Rate_Per_Hour")
  /// Default par (cases) for new SKUs and any item with alert level 0 — drives Orders low-stock.
  defaultParCases           Int      @default(2) @map("default_par_cases")
  updatedAt                 DateTime @updatedAt

  @@index([updatedAt])
  @@index([storeId])
  @@map("store_settings")
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// Bcrypt hash for Credentials sign-in (store staff PIN/password).
  passwordHash  String?
  position      String
  role          Role      @default(FLOOR_STAFF)
  /// Employee hourly wage for BOM / batch labor costing (falls back to store default when null).
  hourlyRate    Float?    @map("hourly_rate_per_hour")
  /// Bumped when the password changes. JWTs must carry the same value. Deletion does not bump a row.
  credentialVersion Int   @default(0) @map("credential_version")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  @@index([role, name])
  @@index([role])
  @@map("staff_users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("auth_verification_tokens")
}

model Recipe {
  id                String       @id @default(uuid())
  name              String
  category          String?
  outputProductId   String
  outputProduct     Product      @relation("RecipeOutputProduct", fields: [outputProductId], references: [id], onDelete: Restrict)
  yieldPortions     Float        @map("batchYieldQty")
  portionSize       String?
  instructions      String       @default("") @db.Text
  targetRetailPrice Float
  prepTimeMinutes   Int          @default(25)
  /// Bill of materials — fixed batch costs (Juices_recipes_summary parity).
  laborHours            Float  @default(0) @map("Labor_Hours")
  laborRate             Float? @map("Labor_Rate_Per_Hour")
  packagingCostPerUnit  Float  @default(0) @map("Packaging_Cost_Per_Unit")
  status            RecipeStatus @default(PROPOSED)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  bomLines      RecipeBOM[]
  recipeFusions RecipeFusion[]

  @@index([outputProductId])
  @@index([status])
  @@map("recipes")
}

model RecipeBOM {
  id                  String   @id @default(uuid())
  recipeId            String
  recipe              Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientProductId String
  ingredientProduct   Product  @relation("BomIngredientProduct", fields: [ingredientProductId], references: [id], onDelete: Restrict)
  quantityRequired    Float    @map("requiredQty")
  unit                UnitType
  allowVariance       Boolean  @default(true)
  notes               String?

  @@unique([recipeId, ingredientProductId])
  @@index([recipeId])
  @@index([ingredientProductId])
  @@map("recipe_boms")
}

model Bundle {
  id          String       @id @default(uuid())
  name        String
  bundleSku   String       @unique
  description String?
  bundlePrice Float
  discountPct Float?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  items       BundleItem[]
  posMappings POSMapping[]

  @@map("bundles")
}

model BundleItem {
  id        String  @id @default(uuid())
  bundleId  String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Float

  @@unique([bundleId, productId])
  @@index([bundleId])
  @@index([productId])
  @@map("bundle_items")
}

model POSMapping {
  id          String   @id @default(uuid())
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  bundleId    String?
  bundle      Bundle?   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  externalSku String
  posSystem   String   @default("DEFAULT")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([posSystem, externalSku])
  @@index([productId])
  @@index([bundleId])
  @@index([externalSku, isActive])
  @@map("pos_mappings")
}

model Supplier {
  id           String   @id @default(cuid())
  name         String   @unique
  contactName  String?  @map("contact_name")
  contactPhone String?  @map("contact_phone")
  contactEmail String?  @map("contact_email")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  invoices               VendorInvoice[]
  priceVarianceLogs      PriceVarianceLog[]
  qualityEvents          SupplierQualityEvent[]
  receivingDispositions  ReceivingDisposition[]

  @@map("suppliers")
}

model VendorInvoice {
  id                  String          @id @default(uuid())
  vendorName          String
  supplierId          String?         @map("supplier_id")
  supplier            Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invoiceNumber       String?
  invoiceDate         DateTime
  totalAmount         Float
  departmentBreakdown Json
  status              String          @default("PROCESSED")
  rawOcrJson          Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  invoiceLineItems    InvoiceLineItem[]
  priceVarianceLogs   PriceVarianceLog[]

  @@index([supplierId])
  @@index([supplierId, createdAt])
  @@map("vendor_invoices")
}

model InvoiceLineItem {
  id              String         @id @default(uuid())
  invoiceId       String
  invoice         VendorInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name            String
  department      Department
  quantity        Float
  unit            String
  unitCost        Float
  totalCost       Float
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  casePackSize        Float?
  subUnit             String?
  ocrLineConfidence   Float?   @map("ocr_line_confidence")
  costVariancePct     Float?   @map("cost_variance_pct")
  createdAt           DateTime @default(now())

  @@index([invoiceId])
  @@index([invoiceId, createdAt])
  @@index([inventoryItemId])
  @@map("invoice_line_items")
}

/// Automated price spike / guardrail hits (OCR scan or receiving).
model PriceVarianceLog {
  id                String        @id @default(cuid())
  supplierId        String        @map("supplier_id")
  supplier          Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId         String?       @map("product_id")
  product           Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  vendorInvoiceId   String?       @map("vendor_invoice_id")
  vendorInvoice     VendorInvoice? @relation(fields: [vendorInvoiceId], references: [id], onDelete: SetNull)
  itemName          String
  scannedUnitCost   Float         @map("scanned_unit_cost")
  benchmarkCost     Float         @map("benchmark_cost")
  variancePct       Float         @map("variance_pct")
  thresholdPct      Float         @map("threshold_pct")
  source            String
  createdAt         DateTime      @default(now()) @map("created_at")

  @@index([supplierId, createdAt])
  @@index([productId])
  @@index([vendorInvoiceId])
  @@map("price_variance_logs")
}

/// OCR, receiving discrepancy, and quality flags for vendor scorecards.
model SupplierQualityEvent {
  id                     String   @id @default(cuid())
  supplierId             String   @map("supplier_id")
  supplier               Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  eventType              String   @map("event_type")
  productId              String?  @map("product_id")
  vendorInvoiceId        String?  @map("vendor_invoice_id")
  receivingDispositionId String?               @map("receiving_disposition_id")
  receivingDisposition   ReceivingDisposition? @relation(fields: [receivingDispositionId], references: [id], onDelete: SetNull)
  itemName               String?
  metadata               Json?
  createdAt              DateTime              @default(now()) @map("created_at")

  @@index([supplierId, createdAt])
  @@index([eventType])
  @@index([receivingDispositionId])
  @@map("supplier_quality_events")
}

model InventoryItem {
  id                String          @id @default(uuid())
  name              String
  department        Department
  quantity          Float
  unit              String
  receivedCost      Float
  receivedDate      DateTime
  expirationDate    DateTime
  condition         String
  status            InventoryStatus @default(FRESH)
  pullThresholdDays Int             @default(3)
  location          String          @default("Main Storage")
  notes             String?
  casePackSize      Float?
  subUnit           String?
  batchCode         String?
  supplier          String?
  origin            String?
  barcode           String?
  yieldPct          Float?
  margin40Price     Float?
  actualMarginPct   Float?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  productId        String?
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  invoiceLineItems InvoiceLineItem[]

  @@index([status])
  @@index([department])
  @@index([expirationDate])
  @@index([receivedDate])
  @@index([productId])
  @@map("inventory_items")
}

model VoiceLog {
  id               String      @id @default(uuid())
  transcript       String
  audioDurationSec Float?
  parsedData       Json
  targetAction     TargetAction @default(KITCHEN_RESCUE)
  processedAt      DateTime     @default(now())

  @@map("voice_logs")
}

model RecipeFusion {
  id                String       @id @default(uuid())
  recipeName        String
  category          String
  ingredientsUsed   Json
  estimatedYield    String
  estimatedCost     Float
  targetRetailPrice Float
  grossMarginPct    Float
  instructions      String       @db.Text
  status            RecipeStatus @default(PROPOSED)
  prepTimeMinutes   Int?
  chefTips          String?      @db.Text
  allergens         String[]     @default([])
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  recipeId String?
  recipe   Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([category])
  @@index([recipeId])
  @@map("recipe_fusions")
}

/// Lines removed from the receiving board (not stocked): vendor credit or clerk delete.
model ReceivingDisposition {
  id            String    @id @default(uuid())
  externalLogId String    @unique
  itemName      String
  casesReceived Float
  caseCost      Float
  /// NOT_RECEIVED = pending vendor credit; REMOVED = dropped from list (no credit).
  reason        String
  /// PENDING_CREDIT for NOT_RECEIVED; RESOLVED when credited or dismissed.
  status        String    @default("PENDING_CREDIT")
  supplierId    String?   @map("supplier_id")
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  note          String?
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  qualityEvents SupplierQualityEvent[]

  @@index([status])
  @@index([reason])
  @@index([supplierId])
  @@index([reason, status, createdAt])
  @@index([supplierId, createdAt])
  @@map("receiving_dispositions")
}

/// Server-side invoice scan. Commit posts this payload, not numbers supplied by the browser.
model InvoiceOcrDraft {
  id         String    @id @default(uuid())
  staffId    String    @map("staff_id")
  payload    Json
  result     Json?
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("invoice_ocr_drafts")
}

/// Unique key inserted in the same transaction as a receive or invoice post.
model LedgerIdempotencyKey {
  key       String   @id
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ledger_idempotency_keys")
}
