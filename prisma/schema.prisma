// =============================================================================
// FreshLoop AI — Phase 1 Database Schema (Master Development Plan)
// =============================================================================
// RULE 1 (The Ledger): NEVER treat static "Current Stock" as source of truth.
//   Product on-hand quantity MUST be derived via SUM(InventoryTransaction.qtyChange)
//   filtered by product (+ optional location). InventoryItem.quantity is LEGACY only.
// RULE 2 (Location Tracking): Every InventoryTransaction MUST set fromLocation
//   and toLocation (e.g. Retail_Floor, Kitchen_Prep, Waste_Bin, Receiving, POS).
//
// This file implements Master Plan Phase 1 models AND preserves LEGACY/BRIDGE
// tables the live Next.js app still references (VendorInvoice, InvoiceLineItem,
// InventoryItem, VoiceLog, RecipeFusion + existing enums).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Shared / legacy enums (values unchanged — safe for current app code) ────

enum Department {
  PRODUCE
  DAIRY
  BAKERY
  PANTRY
}

enum InventoryStatus {
  FRESH
  WARNING
  PULL_RESCUE
  MARKDOWN
  DISCARDED
}

enum TargetAction {
  KITCHEN_RESCUE
  MARKDOWN
  DISCARD
}

enum RecipeStatus {
  PROPOSED
  IN_KITCHEN
  COMPLETED
}

// ─── Master Plan Phase 1 enums ───────────────────────────────────────────────

/// Ledger movement kinds (Master Plan Transaction_Type).
enum TransactionType {
  Receive
  Sale
  Rescue
  Waste
  POS_Sale
}

/// Physical / logical stock locations (Master Plan From_Location / To_Location).
enum InventoryLocation {
  Receiving
  Retail_Floor
  Kitchen_Prep
  Waste_Bin
  POS
  Supplier
}

// =============================================================================
// MASTER PLAN — Phase 1 canonical models
// =============================================================================

/// Catalog product. Stock is NEVER stored here — use InventoryTransaction SUM.
model Product {
  id           String     @id @default(uuid())
  barcode      String?    @unique
  name         String
  department   Department
  targetMargin Float // Target_Margin e.g. 0.40 = 40%
  unit         String     @default("units") // lbs, units, loaves, L, etc.
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  transactions   InventoryTransaction[]
  posMappings    POSMapping[]
  recipeAsOutput Recipe[]               @relation("RecipeOutputProduct")
  recipeBomLines RecipeBOM[]            @relation("BomIngredientProduct")
  bundleItems    BundleItem[]
  // LEGACY bridge: optional link from batch/UI inventory rows
  inventoryItems InventoryItem[]

  @@index([department])
  @@index([name])
  @@map("products")
}

/// Single source of truth for inventory levels (ledger).
/// Current stock at a location = SUM(qtyChange) WHERE productId AND
///   (toLocation = L contributes +qty, fromLocation = L contributes -qty)
/// or equivalently signed qtyChange with from/to semantics documented in seed.
model InventoryTransaction {
  id              String            @id @default(uuid())
  timestamp       DateTime          @default(now())
  productId       String
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Signed quantity delta in product.unit (positive = into toLocation).
  qtyChange       Float
  transactionType TransactionType
  fromLocation    InventoryLocation
  toLocation      InventoryLocation
  unitCostAtTime  Float? // Unit_Cost_At_Time (moving-average / receive cost snapshot)
  referenceId     String? // invoice id, POS ticket, recipe batch, etc.
  notes           String?
  createdAt       DateTime          @default(now())

  @@index([productId, timestamp])
  @@index([transactionType, timestamp])
  @@index([fromLocation, toLocation])
  @@index([referenceId])
  @@map("inventory_transactions")
}

/// Store-level KPIs / volumetric scrap assumptions (singleton-ish; seed one row).
model StoreSetting {
  id                        String   @id @default(uuid())
  targetWastePct            Float // Target_Waste_Pct e.g. 0.02 = 2%
  scrapBucketVolumeL        Float // Scrap_Bucket_Volume_L
  estimatedWeightPerLiterKg Float // Estimated_Weight_Per_Liter_kg
  storeName                 String?  @default("FreshLoop Demo Store")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("store_settings")
}

/// Manufacturing / rescue recipe: produces an output Product from BOM ingredients.
model Recipe {
  id                String       @id @default(uuid())
  name              String
  category          String? // Soup, Salad, Parfait, etc.
  outputProductId   String
  outputProduct     Product      @relation("RecipeOutputProduct", fields: [outputProductId], references: [id], onDelete: Restrict)
  /// Portions / units of outputProduct yielded per batch (Master Plan yield).
  yieldPortions     Float
  portionSize       String? // e.g. "12 oz"
  instructions      String?      @db.Text
  targetRetailPrice Float?
  status            RecipeStatus @default(PROPOSED)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  bomLines      RecipeBOM[]
  // LEGACY bridge: RecipeFusion batches can point at canonical Recipe
  recipeFusions RecipeFusion[]

  @@index([outputProductId])
  @@index([status])
  @@map("recipes")
}

/// Bill of materials — raw ingredient Product requirements per recipe batch.
model RecipeBOM {
  id                  String  @id @default(uuid())
  recipeId            String
  recipe              Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientProductId String
  ingredientProduct   Product @relation("BomIngredientProduct", fields: [ingredientProductId], references: [id], onDelete: Restrict)
  quantityRequired    Float // in ingredientProduct.unit, per yieldPortions batch
  unit                String? // optional display override

  @@unique([recipeId, ingredientProductId])
  @@index([ingredientProductId])
  @@map("recipe_bom")
}

/// POS Virtual Kitting — sell one SKU, explode into component Product deductions.
model Bundle {
  id          String   @id @default(uuid())
  name        String
  description String?
  posSku      String?  @unique // external POS code for the virtual kit
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items BundleItem[]

  @@map("bundles")
}

model BundleItem {
  id                String  @id @default(uuid())
  bundleId          String
  bundle            Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId         String
  product           Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantityPerBundle Float // units of product deducted per one bundle sale

  @@unique([bundleId, productId])
  @@index([productId])
  @@map("bundle_items")
}

/// Maps external POS SKUs ↔ internal Product_ID.
model POSMapping {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  externalSku String
  posSystem   String   @default("DEFAULT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([posSystem, externalSku])
  @@index([productId])
  @@map("pos_mappings")
}

// =============================================================================
// LEGACY / BRIDGE — tables the live app still uses (do not drop/rename columns)
// =============================================================================

/// LEGACY/BRIDGE: vendor invoice OCR intake (app invoice-ocr flow).
model VendorInvoice {
  id                  String            @id @default(uuid())
  vendorName          String
  invoiceNumber       String?
  invoiceDate         DateTime
  totalAmount         Float
  departmentBreakdown Json // { PRODUCE: float, DAIRY: float, BAKERY: float, PANTRY: float }
  status              String            @default("PROCESSED") // PROCESSED, PENDING, FAILED
  rawOcrJson          Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  lineItems           InvoiceLineItem[]

  @@map("vendor_invoices")
}

/// LEGACY/BRIDGE: invoice line items (optional case-pack fields used by types.ts).
model InvoiceLineItem {
  id              String         @id @default(uuid())
  invoiceId       String
  invoice         VendorInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name            String
  department      Department
  quantity        Float
  unit            String // lbs, kg, cases, crates, liters, units
  unitCost        Float
  totalCost       Float
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  casePackSize    Float?
  subUnit         String?
  createdAt       DateTime       @default(now())

  @@index([inventoryItemId])
  @@map("invoice_line_items")
}

/// LEGACY/BRIDGE: UI/batch inventory rows.
/// IMPORTANT: `quantity` is a temporary bridge for the current dashboard UI.
/// Canonical Product stock MUST be computed from InventoryTransaction (RULE 1).
/// Prefer linking via productId during migration; do not treat this table as SoT.
model InventoryItem {
  id                String          @id @default(uuid())
  name              String
  department        Department
  /// LEGACY bridge only — NOT source of truth for Product stock (see RULE 1).
  quantity          Float
  unit              String // lbs, kg, cases, liters, units, packs
  receivedCost      Float // cost per unit (typically per case in current app)
  receivedDate      DateTime // Item aging: filter receivedDate <= now() - N days
  expirationDate    DateTime
  condition         String // Pristine, Slightly Blemished, Bruised, Overripe, Near Expiry
  status            InventoryStatus @default(FRESH)
  pullThresholdDays Int             @default(3) // 2, 3, or 4 days threshold trigger
  location          String          @default("Main Storage")
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Optional fields aligned with lib/types.ts / mockData (additive bridge)
  casePackSize    Float?
  subUnit         String?
  batchCode       String?
  supplier        String?
  origin          String?
  barcode         String?
  yieldPct        Float?
  margin40Price   Float?
  actualMarginPct Float?

  /// Migration path → Master Plan Product catalog
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  invoiceLineItems InvoiceLineItem[]

  @@index([status])
  @@index([department])
  @@index([expirationDate])
  @@index([receivedDate])
  @@index([productId])
  @@map("inventory_items")
}

/// LEGACY/BRIDGE: voice logger audit trail (parsedData JSON remains the blob).
model VoiceLog {
  id               String       @id @default(uuid())
  transcript       String
  audioDurationSec Float?
  parsedData       Json // items array with quantities, condition, warnings
  targetAction     TargetAction @default(KITCHEN_RESCUE)
  processedAt      DateTime     @default(now())

  @@map("voice_logs")
}

/// LEGACY/BRIDGE: AI recipe-fusion suggestions (ingredientsUsed JSON kept for UI).
/// Prefer linking to canonical Recipe via recipeId for manufacturing (Phase 3).
model RecipeFusion {
  id                String       @id @default(uuid())
  recipeName        String
  category          String // Soup, Salad/Panzanella, Parfait/Dessert, Prepared Hot Meal, Bakery
  ingredientsUsed   Json // LEGACY: Array of { name, quantity, unit, department, estimatedValue }
  estimatedYield    String // LEGACY: e.g. "16 Portions (12 oz)" — kept for UI/back-compat
  estimatedCost     Float
  targetRetailPrice Float
  grossMarginPct    Float
  instructions      String       @db.Text
  status            RecipeStatus @default(PROPOSED)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  /// Migration path → Master Plan Recipe + RecipeBOM
  recipeId String?
  recipe   Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([category])
  @@index([recipeId])
  @@map("recipe_fusions")
}
