// =============================================================================
// FreshLoop AI — Database Schema
// =============================================================================
// This schema keeps the canonical inventory-ledger model and the legacy bridge
// tables needed by the app's current UI and API routes.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TransactionType {
  Receive
  Sale
  Rescue
  Waste
  POS_Sale
}

enum InventoryLocation {
  External_Vendor
  Main_Storage
  Retail_Floor
  Kitchen_Prep
  Deli_Grab_N_Go
  Customer_Out
  Waste_Bin
  Receiving
  Supplier
  POS
}

enum Department {
  PRODUCE
  DAIRY
  BAKERY
  PANTRY
  DELI_KITCHEN
}

enum UnitType {
  KG
  LBS
  LITER
  ML
  UNIT
  BUNCH
  LOAF
  TUB
  CASE
}

enum InventoryStatus {
  FRESH
  WARNING
  PULL_RESCUE
  MARKDOWN
  DISCARDED
}

enum TargetAction {
  KITCHEN_RESCUE
  MARKDOWN
  DISCARD
}

enum RecipeStatus {
  PROPOSED
  IN_KITCHEN
  COMPLETED
}

enum Role {
  ADMIN
  STORE_MANAGER
  RECEIVING_CLERK
  FLOOR_STAFF
  DELI_CHEF
}

model Product {
  id                 String                 @id @default(uuid())
  barcode            String?                @unique
  name               String
  department         Department
  targetMargin       Float                  @default(0.4)
  unitType           UnitType               @default(UNIT)
  casePackSize       Float?                 @default(1)
  parCases           Int                    @default(2)
  yieldPct           Float?                 @default(100)
  shelfLifeDays      Int                    @default(7)
  supplier           String?
  origin             String?
  standardCost       Float?
  retailPrice        Float?
  regularRetailPrice Float?
  isManufactured    Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  transactions   InventoryTransaction[]
  producedRecipes Recipe[]               @relation("RecipeOutputProduct")
  usedInBOMs     RecipeBOM[]            @relation("BomIngredientProduct")
  bundleItems    BundleItem[]
  posMappings    POSMapping[]
  inventoryItems InventoryItem[]

  @@index([department])
  @@index([name])
  @@map("products")
}

model InventoryTransaction {
  id              String            @id @default(uuid())
  timestamp       DateTime          @default(now())
  productId       String            @map("Product_ID")
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  staffId         String            @map("Staff_ID")
  qtyChange       Float             @map("Qty_Change")
  transactionType TransactionType   @map("Transaction_Type")
  fromLocation    InventoryLocation @map("From_Location")
  toLocation      InventoryLocation @map("To_Location")
  unitCostAtTime  Float             @map("Unit_Cost_At_Time")
  referenceId     String?           @map("Reference_ID")
  expirationDate  DateTime?
  notes           String?

  @@index([productId, timestamp])
  @@index([transactionType, timestamp])
  @@index([fromLocation, toLocation])
  @@index([referenceId])
  @@index([expirationDate])
  @@map("Inventory_Transactions")
}

model StoreSetting {
  id                        String   @id @default(uuid())
  storeName                 String   @default("FreshLoop Independent Market")
  targetWastePct            Float    @default(2.5) @map("Target_Waste_Pct")
  scrapBucketVolumeL        Float    @default(20.0) @map("Scrap_Bucket_Volume_L")
  estimatedWeightPerLiterKg Float    @default(0.65) @map("Estimated_Weight_Per_Liter_kg")
  defaultScrapCostPerKg     Float    @default(3.5)
  pullSensitivityDays       Int      @default(3)
  costGuardrailVariancePct  Float    @default(20.0)
  updatedAt                 DateTime @updatedAt

  @@map("store_settings")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  position  String
  role      Role     @default(FLOOR_STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@map("staff_users")
}

model Recipe {
  id                String       @id @default(uuid())
  name              String
  category          String?
  outputProductId   String
  outputProduct     Product      @relation("RecipeOutputProduct", fields: [outputProductId], references: [id], onDelete: Restrict)
  yieldPortions     Float
  portionSize       String?
  instructions      String?      @db.Text
  targetRetailPrice Float?
  status            RecipeStatus @default(PROPOSED)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  bomLines      RecipeBOM[]
  recipeFusions RecipeFusion[]

  @@index([outputProductId])
  @@index([status])
  @@map("recipes")
}

model RecipeBOM {
  id                  String  @id @default(uuid())
  recipeId            String
  recipe              Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientProductId String
  ingredientProduct   Product @relation("BomIngredientProduct", fields: [ingredientProductId], references: [id], onDelete: Restrict)
  quantityRequired    Float
  unit                String?

  @@unique([recipeId, ingredientProductId])
  @@index([ingredientProductId])
  @@map("recipe_bom")
}

model Bundle {
  id          String       @id @default(uuid())
  name        String
  bundleSku   String       @unique
  description String?
  bundlePrice Float
  discountPct Float?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  items       BundleItem[]
  posMappings POSMapping[]

  @@map("bundles")
}

model BundleItem {
  id        String  @id @default(uuid())
  bundleId  String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Float

  @@unique([bundleId, productId])
  @@index([bundleId])
  @@index([productId])
  @@map("bundle_items")
}

model POSMapping {
  id          String   @id @default(uuid())
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  bundleId    String?
  bundle      Bundle?   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  externalSku String
  posSystem   String   @default("DEFAULT")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([posSystem, externalSku])
  @@index([productId])
  @@index([bundleId])
  @@map("pos_mappings")
}

model VendorInvoice {
  id                  String          @id @default(uuid())
  vendorName          String
  invoiceNumber       String?
  invoiceDate         DateTime
  totalAmount         Float
  departmentBreakdown Json
  status              String          @default("PROCESSED")
  rawOcrJson          Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  invoiceLineItems    InvoiceLineItem[]

  @@map("vendor_invoices")
}

model InvoiceLineItem {
  id              String         @id @default(uuid())
  invoiceId       String
  invoice         VendorInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name            String
  department      Department
  quantity        Float
  unit            String
  unitCost        Float
  totalCost       Float
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  casePackSize    Float?
  subUnit         String?
  createdAt       DateTime       @default(now())

  @@index([inventoryItemId])
  @@map("invoice_line_items")
}

model InventoryItem {
  id                String          @id @default(uuid())
  name              String
  department        Department
  quantity          Float
  unit              String
  receivedCost      Float
  receivedDate      DateTime
  expirationDate    DateTime
  condition         String
  status            InventoryStatus @default(FRESH)
  pullThresholdDays Int             @default(3)
  location          String          @default("Main Storage")
  notes             String?
  casePackSize      Float?
  subUnit           String?
  batchCode         String?
  supplier          String?
  origin            String?
  barcode           String?
  yieldPct          Float?
  margin40Price     Float?
  actualMarginPct   Float?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  productId        String?
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  invoiceLineItems InvoiceLineItem[]

  @@index([status])
  @@index([department])
  @@index([expirationDate])
  @@index([receivedDate])
  @@index([productId])
  @@map("inventory_items")
}

model VoiceLog {
  id               String      @id @default(uuid())
  transcript       String
  audioDurationSec Float?
  parsedData       Json
  targetAction     TargetAction @default(KITCHEN_RESCUE)
  processedAt      DateTime     @default(now())

  @@map("voice_logs")
}

model RecipeFusion {
  id                String       @id @default(uuid())
  recipeName        String
  category          String
  ingredientsUsed   Json
  estimatedYield    String
  estimatedCost     Float
  targetRetailPrice Float
  grossMarginPct    Float
  instructions      String       @db.Text
  status            RecipeStatus @default(PROPOSED)
  prepTimeMinutes   Int?
  chefTips          String?      @db.Text
  allergens         String[]     @default([])
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  recipeId String?
  recipe   Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([category])
  @@index([recipeId])
  @@map("recipe_fusions")
}
